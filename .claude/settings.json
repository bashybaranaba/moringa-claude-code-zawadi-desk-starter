{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:actions)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ],
    "ask": ["Bash(npm install)", "Bash(git commit:*)", "Bash(gh pr:*)"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(git push --force*)",
      "Bash(rm -rf*)"
    ]
  }
}
